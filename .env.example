# Contact form delivery via Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional. Defaults: to = the email in lib/content.ts,
# from = "Portfolio <onboarding@resend.dev>" (Resend's test sender, which can
# only deliver to your own Resend account address until you verify a domain).
CONTACT_TO=
CONTACT_FROM=
